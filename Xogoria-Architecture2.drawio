  <diagram id="refactor-canvas" name="3 - Refactor Canvas">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rt" value="Refactor canvas — duplicate this page and rearrange freely" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="current" value="&lt;b&gt;CURRENT ENTRY&lt;/b&gt;&lt;br&gt;xogoriaApi.php&lt;br&gt;1. bootstrap whole app&lt;br&gt;2. refresh user&lt;br&gt;3. route request&lt;br&gt;4. prime mutable worker&lt;br&gt;5. process" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="target" value="&lt;b&gt;POSSIBLE TARGET FLOW&lt;/b&gt;&lt;br&gt;HTTP Request&lt;br&gt;→ Request DTO + validation&lt;br&gt;→ explicit handler/router&lt;br&gt;→ domain service&lt;br&gt;→ typed result&lt;br&gt;→ HTTP response serializer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1250" y="100" width="270" height="180" as="geometry" />
        </mxCell>
        <mxCell id="hot1" value="&lt;b&gt;1. CoreController owns too much&lt;/b&gt;&lt;br&gt;Composition root, service locator, router, and facade are combined. Nearly every request constructs managers and external adapters." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="390" y="90" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="hot2" value="&lt;b&gt;2. Context lifetime is unclear&lt;/b&gt;&lt;br&gt;ContextManager getters return newly built contexts but do not assign them to cached fields. Multiple UserContext instances and DB lookups can occur." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="760" y="90" width="310" height="140" as="geometry" />
        </mxCell>
        <mxCell id="hot3" value="&lt;b&gt;3. Dispatch failure path&lt;/b&gt;&lt;br&gt;Unknown request maps to null, then prime() is called unconditionally. Make unsupported requests an explicit result." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="390" y="280" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="hot4" value="&lt;b&gt;4. Result/response boundary&lt;/b&gt;&lt;br&gt;Workers construct WorkerResult with data, but the scanned class has no constructor and the API entry point does not explicitly serialize/send the result." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="760" y="280" width="310" height="130" as="geometry" />
        </mxCell>
        <mxCell id="hot5" value="&lt;b&gt;5. Currency dependency mismatch&lt;/b&gt;&lt;br&gt;CurrencyWorker receives UserContext but mutation methods call an undeclared $bank. Define one balance service/repository contract." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="390" y="460" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="hot6" value="&lt;b&gt;6. Authentication / authorization seam&lt;/b&gt;&lt;br&gt;Identity is refreshed before dispatch, while worker-level checks vary. Central request policy would make allowed callers and actions visible." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="760" y="460" width="310" height="130" as="geometry" />
        </mxCell>
        <mxCell id="phase1" value="&lt;b&gt;Low-risk first slice&lt;/b&gt;&lt;br&gt;Formalize request validation + unsupported-request response + WorkerResult serialization. Preserve worker behavior." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="90" y="700" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="phase2" value="&lt;b&gt;Second slice&lt;/b&gt;&lt;br&gt;Make contexts request-scoped and single-instance. Inject an explicit UserRepository / BalanceService." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="510" y="700" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="phase3" value="&lt;b&gt;Third slice&lt;/b&gt;&lt;br&gt;Split app construction from routing. Lazily build only the handler dependencies required by the request." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="930" y="700" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="free" value="&lt;b&gt;Design parking lot&lt;/b&gt;&lt;br&gt;Drag notes here, duplicate shapes, and connect proposed ownership boundaries." style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1320" y="650" width="220" height="220" as="geometry" />
        </mxCell>
        <mxCell id="r1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="current" target="hot1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="hot1" target="hot2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="hot2" target="target">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rp1" value="then" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="phase1" target="phase2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
