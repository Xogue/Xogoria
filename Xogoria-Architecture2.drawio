<mxfile host="app.diagrams.net" agent="Codex" compressed="false" pages="4">
  <diagram id="runtime-flow" name="1 - API Runtime Flow">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Xogoria API — current request flow" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="client" value="&lt;b&gt;Browser / bot / external caller&lt;/b&gt;&lt;br&gt;GET, form POST, or JSON POST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;html/api/xogoriaApi.php&lt;/b&gt;&lt;br&gt;refresh identity → select worker → process" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="310" y="125" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="session" value="&lt;b&gt;includes/session.php&lt;/b&gt;&lt;br&gt;starts session&lt;br&gt;loads Composer classmap&lt;br&gt;constructs CoreController" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="310" y="260" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="request" value="&lt;b&gt;RequestData&lt;/b&gt;&lt;br&gt;$_GET / $_POST / php://input" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="630" y="80" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sessiondata" value="&lt;b&gt;SessionData&lt;/b&gt;&lt;br&gt;Twitch identity from $_SESSION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="630" y="180" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="input" value="&lt;b&gt;InputDataContext&lt;/b&gt;&lt;br&gt;request values + session fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="880" y="125" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="identity" value="&lt;b&gt;UserContext refresh&lt;/b&gt;&lt;br&gt;lookup by platform ID, then username" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1160" y="80" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="router" value="&lt;b&gt;CoreController::getContextWorker()&lt;/b&gt;&lt;br&gt;match request, then prime contexts" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1160" y="190" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="collection" value="&lt;b&gt;CollectionWorker&lt;/b&gt;&lt;br&gt;name / objective / quote&lt;br&gt;→ MySqlManager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="190" y="480" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="currency" value="&lt;b&gt;CurrencyWorker&lt;/b&gt;&lt;br&gt;check / set / add / deduct&lt;br&gt;→ user balance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="480" y="480" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="interaction" value="&lt;b&gt;InteractionWorker&lt;/b&gt;&lt;br&gt;resolve game interaction&lt;br&gt;→ panel commands" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="770" y="480" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="configure" value="&lt;b&gt;ConfigureWorker&lt;/b&gt;&lt;br&gt;set active game + profile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1060" y="480" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="result" value="&lt;b&gt;WorkerResult&lt;/b&gt;&lt;br&gt;success / value / message&lt;br&gt;shared result contract" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="650" y="670" width="250" height="90" as="geometry" />
