        <mxCell id="db" value="MySQL" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="650" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="panel" value="Game panel API&lt;br&gt;/servers/{id}/command" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
