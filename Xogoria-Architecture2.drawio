          <mxGeometry x="40" y="20" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="pages" value="&lt;b&gt;Presentation / entry points&lt;/b&gt;&lt;br&gt;Public PHP pages&lt;br&gt;Admin pages&lt;br&gt;API endpoints&lt;br&gt;Browser JavaScript" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingTop=36;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="230" height="160" as="geometry" />
        </mxCell>
        <mxCell id="bootstrap" value="&lt;b&gt;Bootstrap&lt;/b&gt;&lt;br&gt;session.php&lt;br&gt;Composer classmap&lt;br&gt;CoreController" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingTop=36;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="100" width="230" height="160" as="geometry" />
        </mxCell>
        <mxCell id="controllers" value="&lt;b&gt;Controllers&lt;/b&gt;&lt;br&gt;DataController&lt;br&gt;UserController&lt;br&gt;TwitchController" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingTop=36;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="100" width="230" height="160" as="geometry" />
        </mxCell>
        <mxCell id="contexts" value="&lt;b&gt;Contexts / request state&lt;/b&gt;&lt;br&gt;ContextManager&lt;br&gt;InputDataContext + WorkerContext&lt;br&gt;User / Twitch / DataStore contexts&lt;br&gt;RequestData + SessionData" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingTop=36;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="940" y="100" width="270" height="190" as="geometry" />
        </mxCell>
        <mxCell id="workers" value="&lt;b&gt;Worker dispatch&lt;/b&gt;&lt;br&gt;WorkerInterface&lt;br&gt;CollectionWorker&lt;br&gt;CurrencyWorker&lt;br&gt;InteractionWorker&lt;br&gt;ConfigureWorker&lt;br&gt;WorkerResult" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingTop=36;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1280" y="100" width="240" height="210" as="geometry" />
        </mxCell>
        <mxCell id="managers" value="&lt;b&gt;Domain / orchestration managers&lt;/b&gt;&lt;br&gt;Config + Game&lt;br&gt;MySql + Interaction&lt;br&gt;Template + Asset&lt;br&gt;Collection + Lore&lt;br&gt;Cooldown" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingTop=36;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="400" width="270" height="200" as="geometry" />
        </mxCell>
        <mxCell id="domain" value="&lt;b&gt;Domain model&lt;/b&gt;&lt;br&gt;Game → Profile&lt;br&gt;InteractType → Interaction&lt;br&gt;Collections → elements&lt;br&gt;LoreStory → chapter/audio/stream&lt;br&gt;Special interactions" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingTop=36;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="690" y="400" width="270" height="200" as="geometry" />
        </mxCell>
        <mxCell id="infra" value="&lt;b&gt;Infrastructure adapters&lt;/b&gt;&lt;br&gt;MySqlBridge (mysqli)&lt;br&gt;Twitch bridges&lt;br&gt;CurlController&lt;br&gt;DataStore (Redis)&lt;br&gt;JsonHandler / FileMap&lt;br&gt;ReportLogger / ResponseSender" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingTop=36;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1040" y="400" width="290" height="220" as="geometry" />
        </mxCell>
        <mxCell id="external" value="&lt;b&gt;External systems / files&lt;/b&gt;&lt;br&gt;MySQL database&lt;br&gt;Redis&lt;br&gt;Twitch OAuth + Helix&lt;br&gt;Game panel command API&lt;br&gt;JSON config + private config&lt;br&gt;HTML templates + logs" style="swimlane;html=1;rounded=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingTop=36;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1040" y="720" width="290" height="210" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Arrow meaning&lt;/b&gt;&lt;br&gt;solid = constructs or calls&lt;br&gt;dashed = reads/writes or adapts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="d1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="pages" target="bootstrap">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="bootstrap" target="controllers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="controllers" target="contexts">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="contexts" target="workers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="bootstrap" target="managers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="workers" target="managers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="managers" target="domain">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="managers" target="infra">
