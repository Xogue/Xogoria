  <diagram name="Copy of 3 - Refactor Canvas" id="T-AvesTt69ESvMAbeCFD">
    <mxGraphModel dx="1571" dy="931" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="hLtUt27z7DBIgUFHUdXL-0" />
        <mxCell id="hLtUt27z7DBIgUFHUdXL-1" parent="hLtUt27z7DBIgUFHUdXL-0" />
        <mxCell id="hLtUt27z7DBIgUFHUdXL-2" parent="hLtUt27z7DBIgUFHUdXL-1" style="text;html=1;fontSize=24;fontStyle=1;align=left;" value="Refactor canvas — duplicate this page and rearrange freely" vertex="1">
          <mxGeometry height="40" width="800" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="hLtUt27z7DBIgUFHUdXL-3" parent="hLtUt27z7DBIgUFHUdXL-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" value="&lt;b&gt;CURRENT ENTRY&lt;/b&gt;&lt;br&gt;xogoriaApi.php&lt;br&gt;1. bootstrap whole app&lt;br&gt;2. refresh user&lt;br&gt;3. route request&lt;br&gt;4. prime mutable worker&lt;br&gt;5. process" vertex="1">
          <mxGeometry height="150" width="250" x="60" y="110" as="geometry" />
        </mxCell>
        <mxCell id="hLtUt27z7DBIgUFHUdXL-4" parent="hLtUt27z7DBIgUFHUdXL-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" value="&lt;b&gt;POSSIBLE TARGET FLOW&lt;/b&gt;&lt;br&gt;HTTP Request&lt;br&gt;→ Request DTO + validation&lt;br&gt;→ explicit handler/router&lt;br&gt;→ domain service&lt;br&gt;→ typed result&lt;br&gt;→ HTTP response serializer" vertex="1">
          <mxGeometry height="180" width="270" x="1250" y="100" as="geometry" />
        </mxCell>
        <mxCell id="hLtUt27z7DBIgUFHUdXL-5" parent="hLtUt27z7DBIgUFHUdXL-1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;1. CoreController owns too much&lt;/b&gt;&lt;br&gt;Composition root, service locator, router, and facade are combined. Nearly every request constructs managers and external adapters." vertex="1">
          <mxGeometry height="140" width="300" x="390" y="90" as="geometry" />
        </mxCell>
        <mxCell id="hLtUt27z7DBIgUFHUdXL-6" parent="hLtUt27z7DBIgUFHUdXL-1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;2. Context lifetime is unclear&lt;/b&gt;&lt;br&gt;ContextManager getters return newly built contexts but do not assign them to cached fields. Multiple UserContext instances and DB lookups can occur." vertex="1">
          <mxGeometry height="140" width="310" x="760" y="90" as="geometry" />
        </mxCell>
        <mxCell id="hLtUt27z7DBIgUFHUdXL-7" parent="hLtUt27z7DBIgUFHUdXL-1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;3. Dispatch failure path&lt;/b&gt;&lt;br&gt;Unknown request maps to null, then prime() is called unconditionally. Make unsupported requests an explicit result." vertex="1">
          <mxGeometry height="130" width="300" x="390" y="280" as="geometry" />
        </mxCell>
        <mxCell id="hLtUt27z7DBIgUFHUdXL-8" parent="hLtUt27z7DBIgUFHUdXL-1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;4. Result/response boundary&lt;/b&gt;&lt;br&gt;Workers construct WorkerResult with data, but the scanned class has no constructor and the API entry point does not explicitly serialize/send the result." vertex="1">
          <mxGeometry height="130" width="310" x="760" y="280" as="geometry" />
        </mxCell>
        <mxCell id="hLtUt27z7DBIgUFHUdXL-9" parent="hLtUt27z7DBIgUFHUdXL-1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;5. Currency dependency mismatch&lt;/b&gt;&lt;br&gt;CurrencyWorker receives UserContext but mutation methods call an undeclared $bank. Define one balance service/repository contract." vertex="1">
          <mxGeometry height="130" width="300" x="390" y="460" as="geometry" />
        </mxCell>
        <mxCell id="hLtUt27z7DBIgUFHUdXL-10" parent="hLtUt27z7DBIgUFHUdXL-1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;6. Authentication / authorization seam&lt;/b&gt;&lt;br&gt;Identity is refreshed before dispatch, while worker-level checks vary. Central request policy would make allowed callers and actions visible." vertex="1">
          <mxGeometry height="130" width="310" x="760" y="460" as="geometry" />
        </mxCell>
        <mxCell id="hLtUt27z7DBIgUFHUdXL-11" parent="hLtUt27z7DBIgUFHUdXL-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Low-risk first slice&lt;/b&gt;&lt;br&gt;Formalize request validation + unsupported-request response + WorkerResult serialization. Preserve worker behavior." vertex="1">
          <mxGeometry height="120" width="320" x="90" y="700" as="geometry" />
        </mxCell>
        <mxCell id="hLtUt27z7DBIgUFHUdXL-12" parent="hLtUt27z7DBIgUFHUdXL-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Second slice&lt;/b&gt;&lt;br&gt;Make contexts request-scoped and single-instance. Inject an explicit UserRepository / BalanceService." vertex="1">
          <mxGeometry height="120" width="320" x="510" y="700" as="geometry" />
        </mxCell>
        <mxCell id="hLtUt27z7DBIgUFHUdXL-13" parent="hLtUt27z7DBIgUFHUdXL-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Third slice&lt;/b&gt;&lt;br&gt;Split app construction from routing. Lazily build only the handler dependencies required by the request." vertex="1">
          <mxGeometry height="120" width="320" x="930" y="700" as="geometry" />
        </mxCell>
        <mxCell id="hLtUt27z7DBIgUFHUdXL-14" parent="hLtUt27z7DBIgUFHUdXL-1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;fontColor=#666666;" value="&lt;b&gt;Design parking lot&lt;/b&gt;&lt;br&gt;Drag notes here, duplicate shapes, and connect proposed ownership boundaries." vertex="1">
          <mxGeometry height="220" width="220" x="1320" y="650" as="geometry" />
        </mxCell>
        <mxCell id="hLtUt27z7DBIgUFHUdXL-15" edge="1" parent="hLtUt27z7DBIgUFHUdXL-1" source="hLtUt27z7DBIgUFHUdXL-3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" target="hLtUt27z7DBIgUFHUdXL-5">
