{
    "users": {
        "label": "Users",
        "description": "Twitch identities, roles, and Airo Gem balances.",
        "table": "users",
        "primaryKey": "platformUserId",
        "allowAdd": false,
        "fields": {
            "platform": { "label": "Platform", "type": "text", "required": true },
            "platformUserId": {
                "label": "User ID",
                "type": "text",
                "required": true,
                "immutable": true,
                "hidden": true,
                "editable": false
            },
            "username": { "label": "Username", "type": "text", "required": true },
            "displayName": { "label": "Display name", "type": "text" },
            "gemBalance": { "label": "Airo Gems", "type": "integer" },
            "role": {
                "label": "Role",
                "type": "select",
                "options": ["none", "moderator", "admin", "owner"]
            }
        }
    },
    "commands": {
        "label": "Commands",
        "description": "Chat commands shown in the command collection.",
        "table": "collectCommands",
        "primaryKey": "id",
        "fields": {
            "id": {
                "label": "ID",
                "type": "integer",
                "immutable": true,
                "generated": true,
                "hidden": true,
                "editable": false
            },
            "name": { "label": "Name", "type": "text", "required": true },
            "description": { "label": "Description", "type": "textarea" },
            "category": {
                "label": "Category",
                "type": "select",
                "options": ["Utility", "Playful", "Supportive", "Other"],
                "defaultOnAdd": "Other"
            },
            "perms": {
                "label": "Permissions",
                "type": "select",
                "options": ["Everyone", "VIPs", "Mods"],
                "defaultOnAdd": "Everyone"
            },
            "enabled": { "label": "Enabled", "type": "boolean", "defaultOnAdd": true }
        }
    },
    "quotes": {
        "label": "Quotes",
        "description": "Collected stream quotes.",
        "table": "collectQuotes",
        "primaryKey": "id",
        "fields": {
            "id": {
                "label": "ID",
                "type": "integer",
                "immutable": true,
                "generated": true,
                "editable": false
            },
            "text": { "label": "Quote", "type": "textarea", "required": true },
            "speaker": { "label": "Speaker", "type": "text", "defaultOnAdd": "Xogue" },
            "game": { "label": "Game", "type": "text", "defaultOnAdd": "Minecraft" },
            "date": { "label": "Date", "type": "date", "defaultOnAdd": "@today", "editableOnAdd": false },
            "favorite": { "label": "Favorite", "type": "boolean" }
        }
    }
}
