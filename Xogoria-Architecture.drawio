  <diagram id="refactor-canvas" name="3 - Current Flow Discontinuities">
    <mxGraphModel dx="1571" dy="934" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rt" parent="1" style="text;html=1;fontSize=24;fontStyle=1;align=left;" value="Observed current-flow discontinuities" vertex="1">
          <mxGeometry height="40" width="800" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="current" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" value="&lt;b&gt;CURRENT ENTRY&lt;/b&gt;&lt;br&gt;xogoriaApi.php&lt;br&gt;1. bootstrap whole app&lt;br&gt;2. refresh user&lt;br&gt;3. route request&lt;br&gt;4. prime mutable worker&lt;br&gt;5. process" vertex="1">
          <mxGeometry height="150" width="250" x="60" y="110" as="geometry" />
        </mxCell>
        <mxCell id="target" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" value="&lt;b&gt;CURRENT API END&lt;/b&gt;&lt;br&gt;$workerResult is assigned locally&lt;br&gt;No echo or JSON serialization follows in xogoriaApi.php&lt;br&gt;PHP request then ends" vertex="1">
          <mxGeometry height="180" width="270" x="1250" y="100" as="geometry" />
        </mxCell>
        <mxCell id="hot1" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;1. CoreController owns too much&lt;/b&gt;&lt;br&gt;Composition root, service locator, router, and facade are combined. Nearly every request constructs managers and external adapters." vertex="1">
          <mxGeometry height="140" width="300" x="390" y="90" as="geometry" />
        </mxCell>
        <mxCell id="hot2" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;2. Context lifetime is unclear&lt;/b&gt;&lt;br&gt;ContextManager getters return newly built contexts but do not assign them to cached fields. Multiple UserContext instances and DB lookups can occur." vertex="1">
          <mxGeometry height="140" width="310" x="760" y="90" as="geometry" />
        </mxCell>
        <mxCell id="hot3" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;3. Dispatch failure path&lt;/b&gt;&lt;br&gt;Unknown request maps to null, then prime() is called unconditionally on that value." vertex="1">
          <mxGeometry height="130" width="300" x="390" y="280" as="geometry" />
        </mxCell>
        <mxCell id="hot4" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;4. Result/response boundary&lt;/b&gt;&lt;br&gt;Workers construct WorkerResult with data, but the scanned class has no constructor and the API entry point does not explicitly serialize/send the result." vertex="1">
          <mxGeometry height="130" width="310" x="760" y="280" as="geometry" />
        </mxCell>
        <mxCell id="hot5" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;5. Currency dependency mismatch&lt;/b&gt;&lt;br&gt;CurrencyWorker receives UserContext, while its mutation methods call an undeclared $bank property." vertex="1">
          <mxGeometry height="130" width="300" x="390" y="460" as="geometry" />
        </mxCell>
        <mxCell id="hot6" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;6. Authentication / authorization seam&lt;/b&gt;&lt;br&gt;Identity is refreshed before dispatch. CurrencyWorker checks login; Collection, Interaction, and Configure workers do not." vertex="1">
          <mxGeometry height="130" width="310" x="760" y="460" as="geometry" />
        </mxCell>
        <mxCell id="phase1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Rendered-page output&lt;/b&gt;&lt;br&gt;Managers assemble HTML from MySQL rows, domain elements, and template files; PHP echoes it into pages." vertex="1">
          <mxGeometry height="120" width="320" x="90" y="700" as="geometry" />
        </mxCell>
        <mxCell id="phase2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Worker output&lt;/b&gt;&lt;br&gt;Workers return WorkerResult objects to xogoriaApi.php; the entry point stores the object without emitting it." vertex="1">
          <mxGeometry height="120" width="320" x="510" y="700" as="geometry" />
        </mxCell>
        <mxCell id="phase3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;External side effects&lt;/b&gt;&lt;br&gt;MySQL writes, game-panel commands, Twitch calls, Redis queue operations, files/logs, redirects, and Backblaze uploads." vertex="1">
          <mxGeometry height="120" width="320" x="930" y="700" as="geometry" />
        </mxCell>
        <mxCell id="free" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#999999;fontColor=#666666;" value="&lt;b&gt;Scope note&lt;/b&gt;&lt;br&gt;These boxes describe observed code paths only. No intended or proposed routing is represented." vertex="1">
          <mxGeometry height="220" width="220" x="1320" y="650" as="geometry" />
        </mxCell>
        <mxCell id="r1" edge="1" parent="1" source="current" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" target="hot1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r2" edge="1" parent="1" source="hot1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" target="hot2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r3" edge="1" parent="1" source="hot2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" target="target">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rp1" edge="1" parent="1" source="phase1" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=none;" target="phase2" value="separate output path">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rp2" edge="1" parent="1" source="phase2" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=none;" target="phase3" value="side effects may occur">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="source-core-output" name="4 - Shared Inputs to Outputs">
    <mxGraphModel dx="1768" dy="1048" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="s0" />
        <mxCell id="s1" parent="s0" />
        <mxCell id="st" parent="s1" style="text;html=1;fontSize=24;fontStyle=1;align=left;" value="Shared xogoriaApi pipeline — actual sources, packet fields, and outputs" vertex="1">
          <mxGeometry height="40" width="1000" x="30" y="20" as="geometry" />
        </mxCell>
        <mxCell id="snote" parent="s1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontColor=#555555;" value="Solid arrows are observed calls or data movement. Red terminal boxes are where the current path stops or fails before producing the output expected by its caller." vertex="1">
          <mxGeometry height="55" width="620" x="1120" y="15" as="geometry" />
        </mxCell>
        <mxCell id="srcJson" parent="s1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;JSON POST source&lt;/b&gt;&lt;br&gt;InteractCard.js&lt;br&gt;interactPanel.js&lt;br&gt;Content-Type: application/json" vertex="1">
          <mxGeometry height="110" width="230" x="30" y="110" as="geometry" />
